<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header"
        android:padding="12dp"
        android:paddingTop="20dp">

        <ImageButton
            android:id="@+id/btnPrevMonth"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_backup"
            android:contentDescription="Bulan sebelumnya"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"
            android:rotation="180" />

        <TextView
            android:id="@+id/tvMonthTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Agustus 2026"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageButton
            android:id="@+id/btnNextMonth"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_backup"
            android:contentDescription="Bulan berikutnya"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="7"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginTop="8dp">

        <TextView style="@style/WeekDayHead" android:text="Sen" />
        <TextView style="@style/WeekDayHead" android:text="Sel" />
        <TextView style="@style/WeekDayHead" android:text="Rab" />
        <TextView style="@style/WeekDayHead" android:text="Kam" />
        <TextView style="@style/WeekDayHead" android:text="Jum" />
        <TextView style="@style/WeekDayHead" android:text="Sab" />
        <TextView style="@style/WeekDayHead" android:text="Min" />
    </GridLayout>

    <GridLayout
        android:id="@+id/gridMonth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="7"
        android:rowCount="6"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvCalendarInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap tanggal untuk melihat kegiatan hari itu"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:padding="10dp" />

    <LinearLayout
        android:id="@+id/layoutDayTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp" />

</LinearLayout>