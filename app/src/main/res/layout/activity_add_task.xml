<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header"
        android:padding="12dp"
        android:paddingTop="20dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_close"
            android:contentDescription="Tutup"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tambah Kegiatan"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Simpan"
            android:textColor="#FFFFFF"
            android:backgroundTint="#33FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingBottom="40dp">

            <TextView style="@style/label" android:text="Nama Kegiatan *" />
            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contoh: Lari pagi 30 menit"
                android:inputType="text"
                android:layout_marginBottom="14dp" />

            <TextView style="@style/label" android:text="Kategori" />
            <Spinner
                android:id="@+id/spCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etCustomCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tulis kategori baru, misal: Kerja, Belanja…"
                android:inputType="text"
                android:visibility="gone"
                android:layout_marginBottom="14dp" />

            <TextView style="@style/label" android:text="Waktu Mulai" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Button
                    android:id="@+id/btnPickDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pilih tanggal"
                    style="?android:attr/buttonStyleSmall" />

                <Button
                    android:id="@+id/btnPickTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pilih jam"
                    android:layout_marginStart="10dp"
                    style="?android:attr/buttonStyleSmall" />
            </LinearLayout>

            <TextView style="@style/label" android:text="Estimasi durasi (menit)" />
            <EditText
                android:id="@+id/etDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contoh: 30"
                android:inputType="number"
                android:layout_marginBottom="14dp" />

            <TextView style="@style/label" android:text="Catatan (opsional)" />
            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contoh: bawa botol minum"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:layout_marginBottom="14dp" />

            <View style="@style/divider_v" />

            <TextView style="@style/label" android:text="Pengulangan" />
            <Spinner
                android:id="@+id/spRepeat"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <LinearLayout
                android:id="@+id/layoutRepeatInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tvIntervalLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ulangi setiap berapa minggu?"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/etRepeatInterval"
                    android:layout_width="70dp"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutWeekChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginTop="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMon" style="@style/WeekChip"
                    android:text="Sen" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTue" style="@style/WeekChip"
                    android:text="Sel" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWed" style="@style/WeekChip"
                    android:text="Rab" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipThu" style="@style/WeekChip"
                    android:text="Kam" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFri" style="@style/WeekChip"
                    android:text="Jum" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSat" style="@style/WeekChip"
                    android:text="Sab" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSun" style="@style/WeekChip"
                    android:text="Min" />
            </LinearLayout>

            <View style="@style/divider_v" />

            <CheckBox
                android:id="@+id/cbPrepAlarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pengingat BERSIAP-SIAP sebelum mulai"
                android:checked="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ingatkan"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <Spinner
                    android:id="@+id/spPrepMinutes"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <EditText
                android:id="@+id/etPrepCustom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Menit sebelum mulai (angka)"
                android:inputType="number"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <CheckBox
                android:id="@+id/cbStartAlarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alarm WAKTU MULAI"
                android:checked="true"
                android:layout_marginBottom="14dp" />

            <View style="@style/divider_v" />

            <TextView style="@style/label" android:text="Suara Alarm" />
            <Button
                android:id="@+id/btnPickSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎵 Pilih file audio (.mp3 / .opus) dari HP"
                android:layout_marginTop="4dp"
                style="?android:attr/buttonStyleSmall" />

            <TextView
                android:id="@+id/tvSelectedSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Belum ada file dipilih — akan pakai nada alarm default"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnPreviewSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▶ Coba dengarkan"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                style="?android:attr/buttonStyleSmall" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>