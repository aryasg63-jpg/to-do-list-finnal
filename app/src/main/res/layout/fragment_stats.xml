<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="110dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 Statistik"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="10dp">

            <LinearLayout style="@style/stat_card" android:layout_weight="1">
                <TextView android:id="@+id/tvStreak" android:text="0"
                    android:textSize="26sp" android:textStyle="bold" android:textColor="#FFA94D"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Hari beruntun" android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout style="@style/stat_card" android:layout_weight="1">
                <TextView android:id="@+id/tvTotalCompleted" android:text="0"
                    android:textSize="26sp" android:textStyle="bold" android:textColor="#69DB7C"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Total selesai" android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginTop="10dp">

            <LinearLayout style="@style/stat_card" android:layout_weight="1">
                <TextView android:id="@+id/tvWeekCount" android:text="0"
                    android:textSize="22sp" android:textStyle="bold" android:textColor="@color/purple_primary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Minggu ini" android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout style="@style/stat_card" android:layout_weight="1">
                <TextView android:id="@+id/tvMonthCount" android:text="0"
                    android:textSize="22sp" android:textStyle="bold" android:textColor="#4DABF7"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Bulan ini" android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout style="@style/stat_card" android:layout_weight="1">
                <TextView android:id="@+id/tvYearCount" android:text="0"
                    android:textSize="22sp" android:textStyle="bold" android:textColor="#DA77F2"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Tahun ini" android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selesaikan 7 hari terakhir"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="18dp" />

        <LinearLayout
            android:id="@+id/chartWeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rekap per kategori"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="18dp" />

        <LinearLayout
            android:id="@+id/layoutCategoryStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>