<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#6C5CE7"
    android:padding="32dp">

    <TextView
        android:id="@+id/tvAlarmType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WAKTUNYA MULAI"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:letterSpacing="0.1"
        android:alpha="0.85" />

    <TextView
        android:id="@+id/tvClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="07:00"
        android:textColor="#FFFFFF"
        android:textSize="64sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTaskTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Lari pagi 30 menit"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:gravity="center"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="🏃 Olahraga"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:alpha="0.9" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="56dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnSnooze"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Tunda 5 menit"
            android:textColor="#6C5CE7"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Matikan"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF6B6B" />
    </LinearLayout>

</LinearLayout>
